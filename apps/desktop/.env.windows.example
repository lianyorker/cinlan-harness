# Copy the values needed for a local Windows packaging session into your shell.
# This file contains placeholders only; it is not loaded automatically and must not contain secrets.
DSH_DESKTOP_APP_ID=com.cinlan.harness
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://desktop-updates.example.com

# Required when the mandatory-update policy is enabled.
# DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://policy.test.example
# DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://policy.example
# DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

# Required by the signed command: pnpm run package:desktop:win:x64.
DSH_DESKTOP_WINDOWS_CER_FILE=C:\path\to\server.cer
DSH_DESKTOP_WINDOWS_SIGNTOOL=C:\path\to\validated\signtool.exe
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=<SafeNet private-key container name>
DSH_DESKTOP_WINDOWS_TOKEN_PIN=<SafeNet Token Password>

# The explicit unsigned installer command sets DSH_DESKTOP_UNSIGNED=1 itself and does not use the fields above:
# pnpm run package:desktop:win:x64:unsigned
# Unsigned installers end in -unsigned.exe and are not release-signed outputs.
# Directory packaging is also non-artifact unsigned development output:
# pnpm run package:desktop:win:x64:dir

# Optional upload credentials are read only by the separate upload command.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=

{
  "name": "@cinlan/cinlan-web",
  "description": "Cinlan-private Web composition layer: notifications, git, worktree, execution hosts, MCP, voice, usage, security research, and Cinlan Design Studio rows kept out of dsh-web-app so upstream merges stay clean",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lianyorker/cinlan-harness.git",
    "directory": "packages/bundle/cinlan-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {

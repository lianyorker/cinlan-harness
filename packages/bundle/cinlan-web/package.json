    "@deepseek-ai/dsh-api-worktree-task-controller": "workspace:*",
    "@deepseek-ai/dsh-cinlan-remote-tunnel": "workspace:*",
    "@deepseek-ai/dsh-client-keyboard": "workspace:*",

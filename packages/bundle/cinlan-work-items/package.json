{
  "name": "@deepseek-ai/dsh-cinlan-work-items",
  "description": "Opt-in native Work Items Web profile composition with writes disabled by default",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/cinlan-work-items"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-work-items": "workspace:^",
    "@deepseek-ai/dsh-work-items-github": "workspace:^",
    "@deepseek-ai/dsh-work-items-gitlab": "workspace:^",
    "@deepseek-ai/dsh-work-items-linear": "workspace:^",
    "@deepseek-ai/dsh-tool-work-items": "workspace:^",
    "@deepseek-ai/dsh-api-work-items-controller": "workspace:^",
    "@deepseek-ai/dsh-client-ui-work-items": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}

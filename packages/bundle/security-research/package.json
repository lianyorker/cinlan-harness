{
  "name": "@deepseek-ai/dsh-security-research",
  "description": "Security Research profile layer: authorized assessment scope, findings, evidence, vulnerability KB, skills, and workflow guidance",
  "version": "0.1.5-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/security-research"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "presets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@deepseek-ai/dsh-artifact": "workspace:^",
    "@deepseek-ai/dsh-assessment-scope": "workspace:^",
    "@deepseek-ai/dsh-assessment-scope-session": "workspace:^",
    "@deepseek-ai/dsh-assessment-scope-static": "workspace:^",
    "@deepseek-ai/dsh-execution-host": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-finding": "workspace:^",
    "@deepseek-ai/dsh-finding-session": "workspace:^",
    "@deepseek-ai/dsh-security-skills": "workspace:^",
    "@deepseek-ai/dsh-security-workflow-prompt": "workspace:^",
    "@deepseek-ai/dsh-tool-finding": "workspace:^",
    "@deepseek-ai/dsh-tool-vuln-kb": "workspace:^",
    "@deepseek-ai/dsh-vuln-kb-nvd": "workspace:^",
    "@deepseek-ai/dsh-vuln-kb-service": "workspace:^",
    "@deepseek-ai/dsh-artifact-local": "workspace:^",
    "@deepseek-ai/dsh-assessment-scope-settings": "workspace:^",
    "@deepseek-ai/dsh-assessment-scope-tool-policy": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^"
  }
}

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ArchivedSessionsSection > renders the Chinese list, search, and restore controls 1`] = `
<div
  class="section"
>
  <span
    class="wrap search"
  >
    <span
      class="icon"
    >
      <svg
        aria-hidden="true"
        data-content="36e55712"
        fill="none"
        height="16"
        stroke-width="1.3"
        viewBox="0 0 16 16"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      />
    </span>
    <input
      aria-label="搜索已归档会话"
      class="input"
      data-settings-anchor="archived-sessions-search"
      placeholder="搜索已归档会话"
      type="search"
      value=""
    />
  </span>
  <ul
    class="list"
  >
    <li
      class="row"
    >
      <span
        class="identity"
      >
        <span
          class="title"
        >
          Newer session
        </span>
        <span
          class="meta"
        >
          Project · 刚刚
        </span>
      </span>
      <span
        class="actions"
      >
        <button
          aria-label="删除 Newer session"
          class="iconButton"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="9bf454ee"
            fill="none"
            height="14"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
        <button
          aria-label="取消归档 Newer session"
          class="button outline sm"
          type="button"
        >
          取消归档
        </button>
      </span>
    </li>
    <li
      class="row"
    >
      <span
        class="identity"
      >
        <span
          class="title"
        >
          Older session
        </span>
        <span
          class="meta"
        >
          Project · 2天
        </span>
      </span>
      <span
        class="actions"
      >
        <button
          aria-label="删除 Older session"
          class="iconButton"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="9bf454ee"
            fill="none"
            height="14"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
        <button
          aria-label="取消归档 Older session"
          class="button outline sm"
          type="button"
        >
          取消归档
        </button>
      </span>
    </li>
  </ul>
</div>
`;


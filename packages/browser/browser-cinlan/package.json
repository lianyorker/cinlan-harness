{
  "name": "@deepseek-ai/dsh-browser-cinlan",
  "description": "Cinlan JSON CLI provider for the DeepSeek Harness persistent browser capability",
  "version": "0.1.5-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/browser/browser-cinlan"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
